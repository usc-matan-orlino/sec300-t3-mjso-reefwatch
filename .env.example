# Copy this file to .env and fill in your own values.

# Azure Cosmos DB for MongoDB (RU)
COSMOS_CONNECTION_STRING=mongodb://account:key@account.mongo.cosmos.azure.com:10255/?ssl=true&retrywrites=false&replicaSet=globaldb&maxIdleTimeMS=120000
COSMOS_DATABASE=reefwatch

# Azure SQL
SQL_SERVER=my-server.database.windows.net
SQL_DATABASE=reefwatch
SQL_USER=username
SQL_PASSWORD=password
